{
  "name": "motive-service-intelligence",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "db:check": "node --env-file=.env.local --import tsx scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:resilience": "node --env-file=.env.local --import tsx scripts/resilience.ts",
    "format": "prettier --write app components lib scripts tests next.config.ts playwright.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
