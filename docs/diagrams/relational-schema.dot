job_inspections [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#ecd4c6" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#a45c41"><FONT COLOR="white"><B>job_inspections (MongoDB)</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="_id" ALIGN="LEFT">_id</TD><TD ALIGN="LEFT">ObjectId</TD></TR><TR><TD ALIGN="LEFT">UK, REF</TD><TD PORT="booking_id" ALIGN="LEFT">booking_id</TD><TD ALIGN="LEFT">UUID string</TD></TR><TR><TD ALIGN="LEFT">REF</TD><TD PORT="vehicle_id" ALIGN="LEFT">vehicle_id</TD><TD ALIGN="LEFT">UUID string</TD></TR><TR><TD ALIGN="LEFT">REF</TD><TD PORT="centre_id" ALIGN="LEFT">centre_id</TD><TD ALIGN="LEFT">UUID string</TD></TR><TR><TD ALIGN="LEFT">REF</TD><TD PORT="updated_by" ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT">UUID string</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="revision" ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="diagnostic_notes" ALIGN="LEFT">diagnostic_notes</TD><TD ALIGN="LEFT">string (optional)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="items[]" ALIGN="LEFT">items[]</TD><TD ALIGN="LEFT">embedded objects</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="items[].component" ALIGN="LEFT">items[].component</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="items[].result" ALIGN="LEFT">items[].result</TD><TD ALIGN="LEFT">PASS / ATTENTION / FAIL</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="items[].comment" ALIGN="LEFT">items[].comment</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="items[].measurements[]" ALIGN="LEFT">items[].measurements[]</TD><TD ALIGN="LEFT">name, value, unit</TD></TR></TABLE>>];
