digraph G {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="SMART VEHICLE SERVICE AND MAINTENANCE INTELLIGENCE SYSTEM\nRelational Schema Diagram\nSolid lines: SQL foreign keys | Dashed lines: application references to MongoDB", labelloc=t, fontsize=22];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#89798d", arrowsize=0.65];
